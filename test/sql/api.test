# ---------------------------------------------------------------- unified shape

query TTTTTTR
SELECT orchestrator, run_id, pipeline, status, raw_status, trigger, duration_seconds FROM terraform.unified.runs ORDER BY queued_at;
----
terraform	run-net-1	prod-network	cancelled	discarded	manual	3599.0
terraform	run-app-1	prod-app	success	applied	event	1799.0
terraform	run-stg-1	staging-app	success	planned_and_finished	api	49.0
terraform	run-net-2	prod-network	success	applied	manual	1199.0
terraform	run-app-2	prod-app	failed	errored	event	238.0
terraform	run-app-3	prod-app	running	planning	api	NULL

query T
SELECT run_id FROM terraform.unified.runs WHERE status = 'success' AND pipeline = 'prod-app';
----
run-app-1

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/runs?%filter[status]=applied,planned_and_finished,planned_and_saved%filter[workspace_names]=prod-app%';
----
<REGEX>:[1-9]\d*

# running is an open set of statuses, so it is evaluated in the worker.
query T
SELECT run_id FROM terraform.unified.runs WHERE status = 'running';
----
run-app-3

query T
SELECT run_id FROM terraform.unified.runs WHERE raw_status = 'discarded';
----
run-net-1

query TTTTTIR
SELECT run_id, task_run_id, task_name, status, raw_status, attempt, duration_seconds FROM terraform.unified.task_runs ORDER BY run_id, task_name DESC;
----
run-app-1	plan-app-1	plan	success	finished	1	240.0
run-app-1	apply-app-1	apply	success	finished	1	1500.0
run-app-2	plan-app-2	plan	success	finished	1	60.0
run-app-2	apply-app-2	apply	failed	errored	1	120.0
run-app-3	plan-app-3	plan	running	running	1	NULL
run-app-3	apply-app-3	apply	skipped	unreachable	1	NULL
run-net-1	plan-net-1	plan	success	finished	1	116.0
run-net-1	apply-net-1	apply	skipped	unreachable	1	NULL
run-net-2	plan-net-2	plan	success	finished	1	97.0
run-net-2	apply-net-2	apply	success	finished	1	595.0
run-stg-1	plan-stg-1	plan	success	finished	1	48.0
run-stg-1	apply-stg-1	apply	skipped	unreachable	1	NULL

# A run_id filter reads just that run.
query TT
SELECT task_name, status FROM terraform.unified.task_runs WHERE run_id = 'run-app-2' ORDER BY task_name;
----
apply	failed
plan	success

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log') WHERE url LIKE '/runs/run-app-2?include=%';
----
<REGEX>:[1-9]\d*

# Joining unified.runs to its task runs.
query TI
SELECT r.pipeline, count(*) FROM terraform.unified.runs r JOIN terraform.unified.task_runs t ON t.run_id = r.run_id
WHERE t.status = 'skipped' GROUP BY r.pipeline ORDER BY r.pipeline;
----
prod-app	1
prod-network	1
staging-app	1

