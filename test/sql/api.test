# name: test/sql/api.test
# description: HCP Terraform API tables against the strict replay server (test/mock_api/server.py).
# group: [terraform]

require vgi

require-env TERRAFORM_WORKER

require-env TERRAFORM_MOCK_API

statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'terraform' (TYPE vgi, LOCATION '{TERRAFORM_WORKER}');

# Without a secret every API table explains how to create one.
statement error
SELECT * FROM terraform.main.organizations;
----
<REGEX>:.*no terraform secret.*

# A wrong token is a 401 from the API.
statement ok
CREATE SECRET bad (TYPE terraform, TOKEN 'wrong-token', ORGANIZATION 'acme', BASE_URL '{TERRAFORM_MOCK_API}');

statement error
SELECT * FROM terraform.main.organizations;
----
<REGEX>:.*HTTP 401.*

statement ok
DROP SECRET bad;

statement ok
CREATE SECRET tf (TYPE terraform, TOKEN 'test-token', ORGANIZATION 'acme', BASE_URL '{TERRAFORM_MOCK_API}');

# ---------------------------------------------------------------- organization

query TTT
SELECT name, plan_identifier, assessments_enforced FROM terraform.main.organizations ORDER BY name;
----
acme	standard	false
globex	free	true

query TTII
SELECT id, name, workspace_count, team_count FROM terraform.main.projects() ORDER BY id;
----
prj-apps	Applications	2	1
prj-core	Core Infra	2	2

# organization := overrides the secret's default.
query I
SELECT count(*) FROM terraform.main.projects(organization := 'globex');
----
0

query TITT
SELECT name, users_count, visibility, organization_access->>'manage-workspaces' FROM terraform.main.teams() ORDER BY name;
----
network-eng	5	organization	false
owners	2	secret	true

query TTTT
SELECT t.name, a.access, a.state_versions, a.workspace_locking FROM terraform.main.team_access('ws-net') a
JOIN terraform.main.teams() t ON t.id = a.team_id ORDER BY t.name;
----
network-eng	write	read	true
owners	admin	write	true

query TTI
SELECT name, organization_scoped, agent_count FROM terraform.main.agent_pools();
----
datacenter-1	false	3

query TTT
SELECT name, status, ip_address FROM terraform.main.agents('apool-dc1') WHERE status NOT IN ('idle', 'busy');
----
dc1-c	errored	10.1.0.12

query TTT
SELECT name, provider, versions FROM terraform.main.registry_modules() ORDER BY name;
----
eks	aws	[0.3.0]
vpc	aws	[2.1.0, 2.0.0]

query TT
SELECT namespace, name FROM terraform.main.registry_providers();
----
acme	internal

# ---------------------------------------------------------------- workspaces

query TTITTT
SELECT name, project_id, resource_count, current_run_status, locked, tag_names FROM terraform.main.workspaces() ORDER BY name;
----
prod-app	prj-apps	17	planning	false	[prod, app]
prod-network	prj-core	42	applied	false	[prod, network]
sandbox	prj-core	0	NULL	true	[]
staging-app	prj-apps	9	planned_and_finished	false	[staging, app]

# Pushed down: filter[project][id], search[name], filter[current-run][status]; tags := is search[tags].
query T
SELECT name FROM terraform.main.workspaces() WHERE project_id = 'prj-core' ORDER BY name;
----
prod-network
sandbox

query T
SELECT name FROM terraform.main.workspaces() WHERE name = 'prod-app';
----
prod-app

query T
SELECT name FROM terraform.main.workspaces() WHERE current_run_status = 'applied';
----
prod-network

query T
SELECT name FROM terraform.main.workspaces(tags := 'app,prod');
----
prod-app

# search[name] is fuzzy upstream; the exact predicate is still applied.
query T
SELECT name FROM terraform.main.workspaces() WHERE name = 'prod';
----

# LIKE is not translated, but is evaluated exactly in the worker.
query T
SELECT name FROM terraform.main.workspaces() WHERE name LIKE '%-app' ORDER BY name;
----
prod-app
staging-app

query R
SELECT plan_duration_average_seconds FROM terraform.main.workspaces() WHERE name = 'prod-network';
----
95.0

query T
SELECT url FROM terraform.main.workspaces() WHERE name = 'sandbox';
----
<REGEX>:http://127\.0\.0\.1:\d+/app/acme/workspaces/sandbox

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/workspaces?%filter[project][id]=prj-core%';
----
<REGEX>:[1-9]\d*

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/workspaces?%filter[current-run][status]=applied%';
----
<REGEX>:[1-9]\d*

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/workspaces?%search[name]=prod-app%';
----
<REGEX>:[1-9]\d*

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/workspaces?%search[tags]=app,prod%';
----
<REGEX>:[1-9]\d*

# ---------------------------------------------------------------- runs

query TTTIIII
SELECT id, workspace_name, status, resource_additions, resource_changes, resource_destructions, resource_imports
FROM terraform.main.runs() ORDER BY created_at DESC;
----
run-app-3	prod-app	planning	0	0	0	0
run-app-2	prod-app	errored	2	1	0	0
run-net-2	prod-network	applied	3	2	1	0
run-stg-1	staging-app	planned_and_finished	0	0	0	0
run-app-1	prod-app	applied	5	0	4	1
run-net-1	prod-network	discarded	0	0	12	0

query T
SELECT id FROM terraform.main.runs(workspace_id := 'ws-net') ORDER BY id;
----
run-net-1
run-net-2

# status IN, source and workspace_name push down.
query TT
SELECT id, status FROM terraform.main.runs() WHERE status IN ('applied', 'errored') ORDER BY id;
----
run-app-1	applied
run-app-2	errored
run-net-2	applied

query T
SELECT id FROM terraform.main.runs() WHERE source = 'tfe-ui' ORDER BY id;
----
run-net-1
run-net-2

query T
SELECT id FROM terraform.main.runs() WHERE workspace_name = 'staging-app';
----
run-stg-1

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/runs?%filter[source]=tfe-ui%';
----
<REGEX>:[1-9]\d*

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/runs?%filter[workspace_names]=staging-app%';
----
<REGEX>:[1-9]\d*

# A created_at lower bound stops paging once older runs appear (runs are newest first, 2 per page here).
query T
SELECT id FROM terraform.main.runs() WHERE created_at >= TIMESTAMPTZ '2026-11-13 00:00:00+00'
AND status IN ('applied', 'errored', 'discarded', 'planned_and_finished') ORDER BY id;
----
run-app-2
run-net-2

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/runs?%discarded%page[number]=2&%';
----
<REGEX>:[1-9]\d*

query I
SELECT count(*) FROM read_json('{TERRAFORM_MOCK_API}/__log')
WHERE url LIKE '/organizations/acme/runs?%discarded%page[number]=3&%';
----
0

query T
SELECT url FROM terraform.main.runs() WHERE id = 'run-net-2';
----
<REGEX>:http://127\.0\.0\.1:\d+/app/acme/workspaces/prod-network/runs/run-net-2

query TTTT
SELECT source, trigger_reason, is_destroy, has_changes FROM terraform.main.runs() WHERE status = 'planned_and_finished';
----
tfe-api	manual	false	false

query T
SELECT status_timestamps->>'applied-at' FROM terraform.main.runs() WHERE id = 'run-net-2';
----
2026-11-13T09:20:00.000Z

